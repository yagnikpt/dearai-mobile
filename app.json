{
	"expo": {
		"name": "dearai",
		"slug": "dearai",
		"version": "1.0.0",
		"orientation": "portrait",
		"scheme": "dearai",
		"userInterfaceStyle": "automatic",
		"android": {
			"predictiveBackGestureEnabled": false,
			"permissions": [
				"android.permission.RECORD_AUDIO",
				"android.permission.MODIFY_AUDIO_SETTINGS",
				"android.permission.FOREGROUND_SERVICE",
				"android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
			],
			"package": "com.oniondevs.dearai"
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			[
				"expo-font",
				{
					"fonts": [
						"./src/assets/fonts/Rubik-Regular.ttf",
						"./src/assets/fonts/Rubik-Bold.ttf",
						"./src/assets/fonts/Rubik-SemiBold.ttf",
						"./src/assets/fonts/Rubik-Medium.ttf",
						"./src/assets/fonts/DMSerifDisplay.ttf"
					]
				}
			],
			"expo-web-browser",
			"expo-audio",
			"expo-image",
			"expo-splash-screen",
			"expo-status-bar",
			"expo-asset",
			[
				"react-native-nitro-google-signin",
				{
					"androidGoogleServicesFile": "./google-services.json"
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"ios": {
			"bundleIdentifier": "com.oniondevs.dearai"
		}
	}
}
